{
  "name": "@phalanx-engine/engine",
  "version": "0.3.0",
  "private": true,
  "description": "Game-facing facade for Phalanx Engine 0.3. Re-exports runtime, ecs, abilities, physics and math. Advanced snapshot helpers are not included.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@phalanx-engine/abilities": "workspace:*",
    "@phalanx-engine/ecs": "workspace:*",
    "@phalanx-engine/math": "workspace:*",
    "@phalanx-engine/physics": "workspace:*",
    "@phalanx-engine/runtime": "workspace:*"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "node --input-type=module -e \"await import('./dist/index.js')\""
  },
  "keywords": [
    "phalanx",
    "lockstep",
    "deterministic"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ]
}
