{
  "name": "@phalanx-engine/integration",
  "private": true,
  "type": "module",
  "description": "Stage A integration suite for Phalanx Engine. Not part of the published packages and not run by CI.",
  "scripts": {
    "it": "tsx src/cli.ts",
    "it:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint -c eslint.config.js src"
  },
  "dependencies": {
    "@phalanx-engine/engine": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "tsx": "^4.20.5",
    "@types/node": "^20.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^1.0.0"
  }
}
