# Development mode - no authentication required
# This allows quick testing without Google OAuth setup

VITE_SERVER_URL=http://localhost:3000

# Leave VITE_GOOGLE_CLIENT_ID empty to disable auth in dev mode
# VITE_GOOGLE_CLIENT_ID=

# Enable the in-app debug console (Eruda) for iOS/mobile debugging in development
VITE_ENABLE_DEBUG_CONSOLE=true

