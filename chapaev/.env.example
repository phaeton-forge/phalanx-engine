# Game Server URL
VITE_SERVER_URL=http://localhost:3000

# Google OAuth Client ID (required for authentication)
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Make sure to configure:
# - Authorized JavaScript origins: http://localhost:5174 (for development)
# - Authorized redirect URIs: http://localhost:5174 (for development)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Enable the in-app Eruda debug console for mobile/iOS debugging when needed
VITE_ENABLE_DEBUG_CONSOLE=false

