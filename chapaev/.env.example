# Game Server URL
VITE_SERVER_URL=http://localhost:3000

# Enable the in-app Eruda debug console for mobile/iOS debugging when needed
VITE_ENABLE_DEBUG_CONSOLE=false

# Telegram Mini App configuration
# Set these to enable t.me deep-link invite URLs.
# Example: VITE_TELEGRAM_BOT=ChapayevBot  VITE_TELEGRAM_APP=chapayev
VITE_TELEGRAM_BOT=ChapaevOnlineBot
VITE_TELEGRAM_APP=play
