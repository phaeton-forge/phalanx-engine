{
  "name": "@phalanx-engine/runtime",
  "version": "0.3.0",
  "private": true,
  "description": "Isomorphic match runtime for Phalanx Engine: GameDefinition, GameState snapshot contract, MatchRunner, bots as command producers and transports (client and server simulation modes)",
  "type": "module",
  "sideEffects": [
    "./dist/server/simWorker.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced/index.d.ts",
      "import": "./dist/advanced/index.js"
    },
    "./net": {
      "types": "./dist/net/index.d.ts",
      "import": "./dist/net/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "phalanx": {
    "layer": "application",
    "subpaths": {
      "./net": "infrastructure",
      "./server": "infrastructure"
    }
  },
  "dependencies": {
    "@phalanx-engine/ecs": "workspace:*",
    "@phalanx-engine/math": "workspace:*",
    "@phalanx-engine/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@phalanx-engine/client": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@phalanx-engine/client": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "pretest": "pnpm --filter @phalanx-engine/game build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsc -p tests/server/tsconfig.sim-hook.json && tsc -p tsconfig.test.json && vitest run && node --input-type=module -e \"await import('./dist/index.js'); await import('./dist/advanced/index.js'); await import('./dist/net/index.js'); await import('./dist/server/index.js')\"",
    "bench": "node --expose-gc --import tsx bench/snapshot.bench.ts",
    "build:xxh64": "node scripts/build-xxh64-wasm.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@phalanx-engine/abilities": "workspace:*",
    "@phalanx-engine/client": "workspace:*",
    "@phalanx-engine/ecs": "workspace:*",
    "@phalanx-engine/math": "workspace:*",
    "@phalanx-engine/physics": "workspace:*",
    "@phalanx-engine/server": "workspace:*",
    "@types/node": "^20.0.0",
    "fake-indexeddb": "^6.2.2",
    "happy-dom": "^20.8.4",
    "socket.io-client": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^1.0.0",
    "wabt": "^1.0.39"
  },
  "keywords": [
    "lockstep",
    "deterministic",
    "snapshot",
    "replay",
    "server-simulation",
    "phalanx"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phaeton-forge/phalanx-engine.git",
    "directory": "phalanx-runtime"
  },
  "bugs": "https://github.com/phaeton-forge/phalanx-engine/issues",
  "homepage": "https://github.com/phaeton-forge/phalanx-engine/tree/main/phalanx-runtime#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
