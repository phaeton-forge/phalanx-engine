{
  "name": "@phalanx-engine/client",
  "version": "0.1.5",
  "description": "Client library for Phalanx Engine - a game-agnostic deterministic lockstep multiplayer engine",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "multiplayer",
    "game-client",
    "lockstep",
    "deterministic",
    "netcode",
    "socket.io-client",
    "phalanx",
    "game-engine"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phaeton-forge/phalanx-engine.git",
    "directory": "phalanx-client"
  },
  "bugs": "https://github.com/phaeton-forge/phalanx-engine/issues",
  "homepage": "https://github.com/phaeton-forge/phalanx-engine/tree/main/phalanx-client#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@phalanx-engine/math": "workspace:*",
    "pure-rand": "^7.0.1",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@phalanx-engine/server": "workspace:*",
    "rimraf": "^5.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
