{
  "name": "phalanx-engine",
  "version": "0.1.0",
  "private": true,
  "description": "A game-agnostic deterministic lockstep multiplayer engine with authentication, matchmaking, and command synchronization",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test",
    "test:server": "pnpm --filter @phalanx-engine/server test",
    "test:client": "pnpm --filter @phalanx-engine/client test",
    "test:watch": "pnpm -r test:watch",
    "dev:server": "pnpm --filter @phalanx-engine/server dev",
    "dev:client": "pnpm --filter @phalanx-engine/client dev",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "publish:packages": "pnpm -r --filter \"@phalanx-engine/*\" publish --access public --no-git-checks",
    "version:bump": "node scripts/bump-package-versions.mjs",
    "version:bump:minor": "node scripts/bump-package-versions.mjs minor",
    "version:bump:major": "node scripts/bump-package-versions.mjs major"
  },
  "keywords": [
    "multiplayer",
    "game-engine",
    "lockstep",
    "deterministic",
    "netcode",
    "matchmaking"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.20.0"
  }
}
