# Production mode - Google authentication enabled
# Copy this file to .env.production.local and fill in your credentials

# Game Server URL (your deployed server)
VITE_SERVER_URL=https://your-server.herokuapp.com

# Google OAuth Client ID (required for authentication)
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Yandex Cloud deployment credentials (for deploy script)
YC_DEPLOYMENT_SECRET=your-secret
YC_DEPLOYMENT_KEY=your-key
BUCKET_NAME=your-bucket-name


